#!/usr/bin/env bash
# Herdr equivalent of `t`: claude, with nvim on the herdr-nvim sidebar (prefix+e)

set -euo pipefail

if [[ $# -eq 1 ]]; then
    selected=$1
else
    items=$(find ~/code -maxdepth 1 -mindepth 1 -type d)
    items+=$'\n/tmp'
    selected=$(echo "$items" | fzf)
fi

[[ -z ${selected:-} ]] && exit

name=$(basename "$selected" | sed 's/\./_/g')

existing=$(herdr workspace list | jq -r --arg n "$name" '.result.workspaces[] | select(.label == $n) | .workspace_id' | head -1)
if [[ -n $existing ]]; then
    herdr workspace focus "$existing" >/dev/null
    exit
fi

pane=$(herdr workspace create --cwd "$selected" --label "$name" --focus | jq -r '.result.root_pane.pane_id')

herdr pane run "$pane" claude >/dev/null
